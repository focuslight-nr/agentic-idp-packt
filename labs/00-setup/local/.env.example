# Only for running the labs locally with kind.
# In the workshop, you run this: labs/00-setup/local/ (preflight.sh, then bootstrap.sh).
# Ask Cursor to "read labs/02-knowledge-base/kb/guides/onboarding.md" to do the loop.

# Your fork, used by ArgoCD and by the runbook links in alerts
REPO_URL=https://github.com/<your-user>/agentic-idp-packt.git
REPO_WEB_URL=https://github.com/<your-user>/agentic-idp-packt

# Your capped provider key (OpenRouter). The bootstrap installs LiteLLM
# inside the cluster and routes the model alias `qwen3.8-27b` through it.
# You never put this key in an agent; the agent only ever sees its own
# LiteLLM virtual key (alias attendee-local), which the bootstrap creates.
OPENROUTER_API_KEY=sk-or-...

# Optional: gateway admin key. If empty, the bootstrap generates one and
# stores it in labs/00-setup/local/.litellm-admin (used by the kill switch).
LITELLM_MASTER_KEY=

# Optional: set to true to skip the in-cluster Langfuse (the B8 memory
# fallback). Default: install it, create the project and API keys
# headlessly, and wire the LiteLLM callback.
SKIP_LANGFUSE=

# Optional: GitHub token for the runbook bot (contents + pull requests on your fork)
GITHUB_TOKEN=
